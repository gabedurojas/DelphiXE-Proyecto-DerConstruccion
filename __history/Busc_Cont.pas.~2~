end;


procedure TBus_Titulares.FormActivate(Sender: TObject);
begin
if not(gh) then begin
  gh:=true;
  ONOMB.SetFocus;
  if NroOpcion = 2 then begin
    JvgGroupBox1.Visible:=false;
    Consultas(NroOpcion);
  end;
end;
end;

procedure TBus_Titulares.BuscarClick(Sender: TObject);
begin
if (TRIM(onomb.Text)='') and (trim(odni.Text)='') and (trim(OCUIT.Text)='') then begin
 messagedlg('Error.. No Existe ningun Contribuyente segun el Criterio de Busqueda..Por Favor realice otra búsqueda.',mterror,[mbok],0);
 onomb.SetFocus;
 end
 else Consultas(NroOpcion);
end;

procedure TBus_Titulares.Consultas(nro:byte);
var param:string;
    Comando:widestring;
begin
 //Modulo2.ObjConexion:=TADOConnection.Create(nil);
 //Modulo2.ObjConexion.LoginPrompt:=false;
 //Modulo2.ObjConexion.ConnectionString:=Modulo2.Sistema.ConectSeg;
 try
  if nro = 1 then begin
   Modulo2.ObjConexion:=TADOConnection.Create(nil);
   Modulo2.ObjConexion.LoginPrompt:=false;
   Modulo2.ObjConexion.ConnectionString:=Modulo2.Sistema.ConectSeg;
   if trim(ONOMB.Text) <> '' then param:=chr(39) + trim(ONOMB.Text) + chr(39) + ' , '
   else param:='NULL , ';
   if trim(ODNI.Text) <> '' then param:=param + trim(ODNI.Text) + ' , '
   else param:=param + 'NULL , ';
   if trim(OCUIT.Text) <> '' then param:=param + trim(OCUIT.Text)
   else param:=param + 'NULL';
   Comando:='SELECT Id, Contribuyente, FechaNacimiento, Sexo, NroCuit, TipoPersona,Mail, EstadoCivil, Telefono, '
   + 'EsFallecido, Origen, FechaAlta, CUIM, NroDni, TipoDoc, TipoSexo, Barrio, Calle, Altura,IdTpoDoc, TipoDocAbrev,'
   + 'Nacionalidad, IdDomi FROM dbo.Fn_Contribuyentes(' + param + ') ORDER BY Contribuyente';
   TITULARES.Close;
   DTS1.DataSet:=TITULARES;
   TITULARES.Connection:=Modulo2.ObjConexion;
   TITULARES.CommandText:=Comando;
   TITULARES.Open;
   TITULARES.Connection:=nil;
  end;
  if nro = 2 then begin
   Modulo2.ObjConexion:=TADOConnection.Create(nil);
   Modulo2.ObjConexion.LoginPrompt:=false;
   Modulo2.ObjConexion.ConnectionString:=Modulo2.Sistema.ConectSeg;
   Comando:='SELECT DISTINCT Cuim,Contribuyente as Nombre,TipoContribuyente, TipoDoc, DNI, Provincia, Barrio, Calle, '
   + 'Altura, Piso, Depto, Manzana, Casa, Torre, Sector, Parcela, LoteRural, Domicilio '
   + 'FROM PlanesPagos.dbo.Fn_PlanPagoContribuyente (null,1) ORDER BY Contribuyente';
   TITULARES.Close;
   DTS1.DataSet:=TITULARES;
   TITULARES.Connection:=Modulo2.ObjConexion;
   TITULARES.CommandText:=Comando;
   TITULARES.Open;
   TITULARES.Connection:=nil;
  end;
  if nro = 3 then begin
   Modulo2.ObjConexion:=TADOConnection.Create(nil);
   Modulo2.ObjConexion.LoginPrompt:=false;
   Modulo2.ObjConexion.ConnectionString:=Modulo2.Sistema.ConectInti;
   if trim(ONOMB.Text) <> '' then param:=chr(39) + trim(ONOMB.Text) + chr(39) + ' , '
    else param:='NULL , ';
   if trim(ODNI.Text) <> '' then param:=param + trim(ODNI.Text) + ' , '
    else param:=param + 'NULL , ';
   if trim(OCUIT.Text) <> '' then param:=param + trim(OCUIT.Text)
    else param:=param + 'NULL';
   Comando:='SELECT Id, Contribuyente, FechaNacimiento, Sexo, NroCuit, TipoPersona,Mail, EstadoCivil, Telefono,  '
   + 'EsFallecido, Origen, FechaAlta, CUIM, NroDni, TipoDoc, TipoSexo, Barrio, Calle, Altura,'
   + ' IdTpoDoc, TipoDocAbrev, Nacionalidad, IdDomi,IDBoletaDeuda,DeudaBoletaDeuda,NroBoletaDeuda '
   + ' FROM Fn_ContribuyentesBDAsesoriaLegal (' + param + ') ORDER BY Contribuyente';
   TITULARES.Close;
   DTS1.DataSet:=TITULARES;
   TITULARES.Connection:=Modulo2.ObjConexion;
   TITULARES.CommandText:=Comando;
   TITULARES.Open;
   TITULARES.Connection:=nil;
  end;
  if TITULARES.IsEmpty then begin
   messagedlg('Error.. La Busqueda no arrojo ningun Contribuyente..' + chr(13)
   + 'Por favor realice otra busqueda.' ,mterror,[mbok],0);
  end
  else begin
   Barra1.Panels[1].Text:='Cant. Contribuyentes: ' + IntToStr(TITULARES.RecordCount);
   JvDBGrid2.SetFocus;
   JvDBGrid2.Columns[0].Width :=100;
   JvDBGrid2.Columns[1].Width :=250;
  end;
 except
  on E: Exception do begin
   EnviarLog(Self.Caption, E.Message);
   EnviarLog(Self.Caption, comando);
  end;
 end;
 Modulo2.ObjConexion.Close;
 FreeAndNil(Modulo2.ObjConexion);
end;

