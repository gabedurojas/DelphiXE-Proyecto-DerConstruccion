  path:=GetCurrentDir() + '\Imagenes\LOGO08.JPG';
  if FileExists(path) then  Image321.Bitmap.LoadFromFile(path);
  Acceso:=TAcceso.create(self);
  try
    Acceso.ShowModal;
  finally
    if Acceso.control = false then close;
    gh:=true;
    Acceso.destroy;
    MenuAccesos.Enabled:=true;
