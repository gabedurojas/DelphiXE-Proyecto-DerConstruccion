<?xml version="1.0" encoding="utf-8" standalone="no"?>
<TfrxReport Version="4.15.6" DotMatrixReport="False" IniFile="\Software\Fast Reports" PreviewOptions.Buttons="4095" PreviewOptions.Zoom="1" PrintOptions.Printer="Default" PrintOptions.PrintOnSheet="0" ReportOptions.CreateDate="42506.8240951505" ReportOptions.Description.Text="" ReportOptions.LastChange="42983.485957662" ScriptLanguage="PascalScript" ScriptText.Text="&#13;&#10;begin&#13;&#10;&#13;&#10;end." PropData="">
  <TfrxDataPage Name="Data" Height="1000" Left="0" Top="0" Width="1000"/>
  <TfrxReportPage Name="Page1" PaperWidth="210" PaperHeight="297" PaperSize="9" LeftMargin="10" RightMargin="10" TopMargin="10" BottomMargin="10" ColumnWidth="0" ColumnPositions.Text="" HGuides.Text="" VGuides.Text="41.57483">
    <TfrxReportTitle Name="ReportTitle1" Height="884.41002" Left="0" Top="18.89765" Width="718.1107">
      <TfrxMemoView Name="Memo2" Left="449.76407" Top="18.89765" Width="124.72449" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="1" HAlign="haCenter" ParentFont="False" Text="DISPOSICION Nº"/>
      <TfrxMemoView Name="Memo38" Left="5.55906" Top="109.60637" Width="710.55164" Height="37.7953" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-12" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="                           La Ordenanza N° 1590/86, Código Tributario Municipal, que regula la Ejecución Fiscal y la Ordenanza N° 6317/12 que determina las competencias del Organismo Fiscal y los deberes formales de los contribuyentes, responsable y terceros, y;"/>
      <TfrxMemoView Name="Memo11" Left="3.77953" Top="175.07885" Width="714.33117" Height="457.32313" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-12" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="                      Que conforme a las compulsas realizadas por la Agencia de Recaudación Municipal, no existen constancias de pago de los saldos adeudados por los contribuyentes citados en el Anexo I, en relación a los periodos y tributos detallados en las Boletas de Deudas que se incluyen en el  Anexo I, correspondiendo en consecuencia efectuar la emisión de las Boletas de Deudas, por las deudas de los tributos con mas sus accesorios legales.&#13;&#10;&#13;&#10;                        Que el presente control se realizó en base a las Declaraciones Juradas presentadas respecto de la Tasa de Registro e Inspección, según Ordenanza N° 6253/12, del Uso del Espacio Aéreo y subsuelo, Ordenanza N° 3499/95; y las Liquidaciones Administrativas de la Tasa de Utilización de la Vía Pública, Ordenanza N° 4052/92, la Tasa Única de Servicios Municipales, Ordenanza N° 4616/03, el Impuesto Inmobiliario, Ordenanza N° 2972/94, el Derecho de Publicidad y Propaganda, Ordenanza N° 5733/09, con sus Ordenanzas modificatorias y complementarias.                                    &#13;&#10;&#13;&#10;                      Que los citados saldos detallados en las Boletas de Deudas que forman parte del Anexo I, surgen por la falta de pago (total o parcial) de las Tasas, Derechos y demás Tributos Municipales.&#13;&#10;&#13;&#10;                   Que el Art. 1 de la Ordenanza N° 6317/12, en su parte pertinente prescribe que: “…Es autoridad de aplicación del presente Código y de las Ordenanzas Tributarias que se dicten, la Secretaría de Hacienda de la Municipalidad de Formosa, a través de su Organismo Fiscal, la Dirección de Ingresos Municipales.”&#13;&#10;&#13;&#10;                     Que el Art. 12 de la Ordenanza N° 6317/12, expresa que: “Para el cumplimiento de sus funciones, el Organismo Fiscal tiene las siguientes Facultades:…o) Emitir constancia de deuda para el cobro judicial de los tributos…y v) Realizar todas otra acción necesaria para el cumplimiento con las funciones encomendadas por este Código.”                                       &#13;&#10;&#13;&#10;                     Que el Art. 24 de la Ordenanza N° 6317/12, manifiesta: “Los contribuyentes, responsables y terceros  deberán cumplir los deberes que este Código, Ordenanzas tributarias especiales y sus reglamentaciones establezcan con el fin de facilitar la determinación, verificación, fiscalización, percepción y ejecución de las obligaciones fiscales…” &#13;&#10;&#13;&#10;                  Que el Título XXXI, de la Ordenanza N° 1590/86, Código Tributario Municipal, en sus Arts. 185 a 188,  regula la Ejecución  Fiscal, facultando  a la Municipalidad a proceder al cobro judicial por vía ejecutiva de los impuestos, derechos, tasas, contribuciones, sus intereses, recargos, actualizaciones y multas y todo otro crédito fiscal, una vez vencidos los plazos generales o especiales para el pago, sin necesidad de intimación o requerimiento individual alguno.&#13;&#10;&#13;&#10;                         Que por todo lo expuesto es necesario dictar el acto administrativo de rigor, por ello:"/>
      <TfrxMemoView Name="NroDispo" Left="577.60668" Top="18.89765" Width="79.37013" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="1" ParentFont="False" Text="[NroDispo]"/>
      <TfrxMemoView Name="Memo3" Left="3.77953" Top="52.91342" Width="139.84261" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="1" ParentFont="False" Text="FORMOSA"/>
      <TfrxMemoView Name="Memo10" Left="3.77953" Top="79.37013" Width="139.84261" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="5" ParentFont="False" Text="VISTO:"/>
      <TfrxMemoView Name="Memo13" Left="3.77953" Top="151.1812" Width="139.84261" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="5" ParentFont="False" Text="CONSIDERANDO:"/>
      <TfrxMemoView Name="Memo12" Left="71.81107" Top="631.74057" Width="566.9295" Height="52.91342" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="1" HAlign="haCenter" ParentFont="False" Text="EL DIRECTOR DE LA AGENCIA DE RECAUDACIÓN &#13;&#10;DEPENDIENTE DE LA SECRETARÍA DE HACIENDA&#13;&#10;DISPONE:"/>
      <TfrxMemoView Name="Memo14" Left="3.77953" Top="689.77211" Width="170.07885" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="1" ParentFont="False" Text="ARTICULO 1°) LÍBRESE "/>
      <TfrxMemoView Name="Memo15" Left="3.77953" Top="758.46506" Width="181.41744" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="1" ParentFont="False" Text="ARTICULO 2°) REMÍTASE "/>
      <TfrxMemoView Name="Memo16" Left="3.77953" Top="838.4966" Width="222.99227" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="1" ParentFont="False" Text="ARTICULO 3°) COMUNÍQUESE, "/>
      <TfrxMemoView Name="Memo17" Left="275.90569" Top="860.39425" Width="139.84261" Height="18.89765" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-15" Font.Name="Arial" Font.Style="5" HAlign="haCenter" ParentFont="False" Text="ANEXO I"/>
      <TfrxMemoView Name="Memo18" Left="225.7718" Top="840.4966" Width="710.55164" Height="15.11812" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-12" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="Regístrese, Cumplido ARCHÍVESE."/>
      <TfrxMemoView Name="Memo19" Left="176.19697" Top="692.55164" Width="710.55164" Height="15.11812" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-12" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="las BOLETAS DE DEUDA N° [Min] a N° [Max] (ANEXO I), por los Tributos Municipales y"/>
      <TfrxMemoView Name="Memo20" Left="188.19697" Top="759.46506" Width="710.55164" Height="15.11812" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-12" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="en cumplimiento de los dispuesto por el Art. 1 de la Ordenanza N° 6317/12, a la Secretaría de "/>
      <TfrxMemoView Name="Memo21" Left="3.77953" Top="706.77211" Width="710.55164" Height="45.35436" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-12" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="periodos adeudados por los contribuyentes incluidos en el ANEXO I, con el fin de obtener el cobro de dichas deudas, en virtud de lo prescripto por los Art. 185 a 188 de la Ordenanza N° 1590/86, Código Tributario Municipal, y los Art. 1, 12 y 24 de la Ordenanza N° 6317/12, como se detalla en el Considerando."/>
      <TfrxMemoView Name="Memo22" Left="3.33859" Top="775.24459" Width="710.55164" Height="60.47248" ShowHint="False" Font.Charset="1" Font.Color="0" Font.Height="-12" Font.Name="Arial" Font.Style="0" HAlign="haBlock" ParentFont="False" Text="Hacienda, por Mesa de Entrada de la Agencia de Recaudación Municipal sendas Notas, adjuntando los duplicados de las Boletas de Deuda libradas por la presente Disposición, solicitando la rúbrica de las mismas por el Secretario de Hacienda, Contador Público Federico Tomás, previo al envío de las mismas a la Unidad Legal, Técnica y Procuración Municipal, a los efectos de continuar con el trámite de cobro por la vía de Apremio."/>
    </TfrxReportTitle>
